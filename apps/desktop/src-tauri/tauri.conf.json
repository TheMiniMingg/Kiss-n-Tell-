{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiss N Tell",
  "version": "../package.json",
  "identifier": "io.github.theminimingg.kissntell",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run dev:frontend",
    "beforeBuildCommand": "pnpm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiss N Tell",
        "width": 1200,
        "height": 840,
        "minWidth": 420,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Rare-answer trivia with an offline pack editor",
    "longDescription": "Kiss N Tell is a rare-answer trivia game for adults. Pick a topic, answer 7 questions with one word each, and score more for rarer answers. The desktop app also lets you make your own topic packs offline.",
    "copyright": "MIT License",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
